# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="StreamTube" <noreply@streamtube.com>
# Object storage (MinIO) — phase-03-videos/TD-01
STORAGE_ENDPOINT=minio
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=streamtube
STORAGE_SECRET_KEY=streamtube
STORAGE_REGION=us-east-1
STORAGE_BUCKET=streamtube-media
# Host que assina as URLs pré-assinadas. Em dev é o mesmo serviço do Compose,
# para que as URLs valham dentro da rede (inclusive nos testes).
STORAGE_PUBLIC_ENDPOINT=http://minio:9000

# Upload multipart — phase-03-videos/TD-03
UPLOAD_MAX_BYTES=10737418240
UPLOAD_PART_SIZE_BYTES=8388608
UPLOAD_URL_EXPIRATION_SECONDS=3600
DELIVERY_URL_EXPIRATION_SECONDS=3600

# Fila de processamento (RabbitMQ) — phase-03-videos/TD-02
RABBITMQ_URL=amqp://streamtube:streamtube@rabbitmq:5672
VIDEO_QUEUE_NAME=video.processing
VIDEO_JOB_MAX_ATTEMPTS=3
VIDEO_JOB_RETRY_DELAY_MS=2000
